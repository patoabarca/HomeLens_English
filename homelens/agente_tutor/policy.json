    "max_turnos": 5,
    "max_intentos_por_actividad": 3,
    "max_pistas_por_actividad": 2,
    "max_pistas_totales": 4,
    "max_refuerzos": 2,
    "min_objetos_actividad": 1,
    "max_objetos_actividad": 3,
    "max_longitud_respuesta_chars": 300
  },
  "allowed_events_by_state": {
    "INACTIVA": [
      "INICIAR_PRACTICA"
    ],
    "ESPERANDO_RESPUESTA": [
      "PEDIR_PISTA",
      "ENVIAR_RESPUESTA",
      "CERRAR_PRACTICA"
    ],
    "EVALUADA": [
      "PEDIR_PISTA",
      "ENVIAR_RESPUESTA",
      "AVANZAR_ACTIVIDAD",
      "CERRAR_PRACTICA"
    ],
    "FINALIZADA": [
      "INICIAR_PRACTICA",
      "CERRAR_PRACTICA"
    ]
  },
  "allowed_pedagogical_actions_by_state": {
    "INACTIVA": [
      "PREPARAR_ACTIVIDAD"
    ],
    "ESPERANDO_RESPUESTA": [
      "OFRECER_PISTA",
      "EVALUAR_RESPUESTA",
      "CERRAR"
    ],
    "EVALUADA": [
      "AVANZAR",
      "PERMITIR_OTRO_INTENTO",
      "OFRECER_PISTA",
      "PREPARAR_REFUERZO",
      "CERRAR"
    ],
    "FINALIZADA": [
      "CERRAR"
    ]
  },
  "security": {
    "require_active_photo_object_ids": true,
    "treat_student_input_as_untrusted": true,
    "ignore_embedded_instructions": true,
    "hide_internal_grading_criteria_from_ui": true
  }
