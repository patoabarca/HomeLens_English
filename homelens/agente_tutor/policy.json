{
  "agent_name": "agente_tutor",
  "version": "1.0.0",
  "description": "Política compartida del Agente Tutor de vocabulario de HomeLens English",
  "enabled_skills": [
    "orquestar-practica",
    "preparar-actividad",
    "evaluar-respuesta",
    "dar-pista"
