# ==========================================
# HomeLens English - Variables de Entorno de Ejemplo
# Copie este archivo como .env y complete con sus credenciales cuando corresponda.
# Para el modo demostración (local / docker), las credenciales externas pueden dejarse vacías.
# ==========================================

# Configuración de la Aplicación
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
APP_PORT=8501

# Google Gemini API (Multimodal para reconocimiento de objetos cotidianos)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60.0
GEMINI_MAX_RETRIES=1

# Supabase Auth y Base de Datos (Autenticación delegada con Google)
# NOTA DE SEGURIDAD: Nunca exponga ni use SUPABASE_SERVICE_ROLE_KEY para autenticar usuarios en el cliente.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Configuración de Flujo OAuth y Sesiones
# En desarrollo local: http://localhost:8501 (o el puerto configurado en APP_PORT)
# En producción: https://su-dominio.com (debe utilizar HTTPS)
AUTH_REDIRECT_URL=http://localhost:8501
AUTH_REQUIRED=True

# Modo Demostración Local (Exclusivo para pruebas locales de desarrollo)
# Si es True, permite ingresar con un usuario sintético de prueba sin conectar a Supabase.
# En producción debe ser False en todo momento.
ALLOW_DEMO_LOGIN=False

# Google Cloud Text-to-Speech / TTS (Opcional en modo demo)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=en-US-Standard-C

# Límites Operativos y Caché
MAX_IMAGE_SIZE_BYTES=10000000
AUDIO_CACHE_TTL_SECONDS=3600
RATE_LIMIT_EXPLORACIONES_POR_MINUTO=10
