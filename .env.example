# ==========================================
# HomeLens English - Variables de Entorno de Ejemplo
# Copie este archivo como .env y complete con sus credenciales cuando corresponda.
# Para el modo demostración (local / docker), las credenciales externas pueden dejarse vacías.
# ==========================================

# Configuración de la Aplicación
APP_ENV=development
DEBUG=True
LOG_LEVEL=INFO
APP_PORT=8501

# Google Gemini API (Opcional en modo demo)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Supabase - Autenticación y Base de Datos (Opcional en modo demo)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Text-to-Speech / TTS (Opcional en modo demo)
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE_NAME=en-US-Standard-C

# Límites y Caché
MAX_IMAGE_SIZE_BYTES=10000000
AUDIO_CACHE_TTL_SECONDS=3600
RATE_LIMIT_EXPLORACIONES_POR_MINUTO=10
